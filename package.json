{
  "name": "piano-sprout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ios:sync": "npm run build && node scripts/prepare-firebase-ios.mjs && cap sync ios",
    "ios:open": "cap open ios",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:firebase": "npx -y firebase-tools@latest emulators:exec --project demo-piano-sprout --config firebase.emulators.json --only auth,firestore \"node --test tests/firebase/*.test.mjs && npm run test:auth\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "firebase": "12.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
