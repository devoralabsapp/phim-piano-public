# Firebase client configuration for your own project (no admin/service-account keys).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Named Firestore database. Use (default) if your project uses the default database.
VITE_FIREBASE_DATABASE_ID=piano-sprout
# Local development only; requires Firebase Auth + Firestore emulators.
VITE_FIREBASE_EMULATORS=false
